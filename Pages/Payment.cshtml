@page
@model APLH.Pages.PaymentModel
@{
    ViewData["Title"] = "Payment - " + Model.Course.Title;
}

<style>
    .pay-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }
</style>

<div class="page-header">
    <h1 style="margin:0;">Complete Your <span style="color:var(--accent)">Enrollment</span></h1>
</div>

<div style="max-width:960px; margin:2.5rem auto; padding:0 1.5rem; display:grid; grid-template-columns:1.4fr 1fr; gap:2rem; align-items:start;">

    <!-- Payment form -->
    <div class="sidebar-card">
        <h2 style="margin-top:0;">Payment <span style="color:var(--accent3)">Details</span></h2>
        <div class="alert" id="paymentAlert"></div>

        <!-- Method tabs -->
        <div style="display:flex; gap:8px; margin-bottom:1.25rem;">
            <button type="button" class="btn btn-ghost pay-tab active" id="tabCardBtn" style="flex:1; padding:10px;" onclick="switchPayTab('card')">
                💳 Card
            </button>
            <button type="button" class="btn btn-ghost pay-tab" id="tabWalletBtn" style="flex:1; padding:10px;" onclick="switchPayTab('wallet')">
                📱 E-Wallet
            </button>
        </div>

        <!-- Card panel -->
        <div id="cardPanel">
            <div class="form-group">
                <label>Name on Card</label>
                <input type="text" id="cardName" placeholder="e.g. John Tan">
                <div class="form-error" id="cardNameErr">Please enter the name on the card.</div>
            </div>

            <div class="form-group">
                <label>Card Number</label>
                <input type="text" id="cardNumber" maxlength="19" placeholder="4242 4242 4242 4242">
                <div class="form-error" id="cardNumberErr">Enter a valid 16-digit card number.</div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="form-group">
                    <label>Expiry (MM/YY)</label>
                    <input type="text" id="cardExpiry" maxlength="5" placeholder="12/28">
                    <div class="form-error" id="cardExpiryErr">Enter a valid expiry date.</div>
                </div>
                <div class="form-group">
                    <label>CVV</label>
                    <input type="text" id="cardCvv" maxlength="4" placeholder="123">
                    <div class="form-error" id="cardCvvErr">Enter a valid CVV.</div>
                </div>
            </div>

            <p style="font-size:0.75rem; color:var(--text3); margin:-0.25rem 0 1.25rem;">
                🔒 This is for demo purposes only. Any card details you enter are not stored or transmitted anywhere.
            </p>

            <button class="btn btn-primary" id="payBtnCard" style="width:100%; padding:14px; font-size:1rem;" onclick="submitCardPayment(@Model.Course.Id)">
                Pay RM @Model.Course.Price.ToString("0.00")
            </button>
        </div>

        <!-- E-Wallet panel -->
        <div id="walletPanel" style="display:none;">
            <div class="form-group">
                <label>Choose E-Wallet</label>
                <select id="walletProvider">
                    <option value="TouchNGo">Touch 'n Go eWallet</option>
                    <option value="GrabPay">GrabPay</option>
                    <option value="Boost">Boost</option>
                    <option value="ShopeePay">ShopeePay</option>
                </select>
            </div>

            <div class="form-group">
                <label>Mobile Number</label>
                <input type="text" id="walletPhone" maxlength="12" placeholder="e.g. 0123456789">
                <div class="form-error" id="walletPhoneErr">Enter a valid mobile number.</div>
            </div>

            <div id="walletQrBox" style="display:none; text-align:center; padding:1.5rem 0;">
                <div style="font-size:3rem;">📲</div>
                <p style="color:var(--text2); font-size:0.875rem; margin:0.5rem 0 0;" id="walletStatusText">
                    Waiting for approval in your e-wallet app...
                </p>
            </div>

            <p style="font-size:0.75rem; color:var(--text3); margin:-0.25rem 0 1.25rem;">
                🔒 This is for demo purposes. No real provider is contacted.
            </p>

            <button class="btn btn-primary" id="payBtnWallet" style="width:100%; padding:14px; font-size:1rem;" onclick="submitWalletPayment(@Model.Course.Id)">
                Pay RM @Model.Course.Price.ToString("0.00") with E-Wallet
            </button>
        </div>

        <button class="btn btn-ghost" style="width:100%; padding:12px; margin-top:10px;" onclick="location.href='/CoursesDetails?id=@Model.Course.Id'">
            Cancel
        </button>
    </div>

    <!-- Order summary -->
    <div class="sidebar-card">
        <h2 style="margin-top:0;">Order <span style="color:var(--accent3)">Summary</span></h2>
        <div style="display:flex; gap:12px; align-items:center; margin-bottom:1rem;">
            <div style="font-size:2rem;">@Model.Course.Emoji</div>
            <div>
                <div style="font-weight:700;">@Model.Course.Title</div>
                <div style="font-size:0.8125rem; color:var(--text2);">@Model.Course.Category &middot; @Model.Course.Level</div>
            </div>
        </div>
        <div style="border-top:1px solid var(--border); padding-top:1rem; display:flex; justify-content:space-between; font-size:0.9375rem; color:var(--text2);">
            <span>Course price</span>
            <span>RM @Model.Course.Price.ToString("0.00")</span>
        </div>
        <div style="border-top:1px solid var(--border); margin-top:0.75rem; padding-top:0.75rem; display:flex; justify-content:space-between; font-weight:700; font-size:1.0625rem;">
            <span>Total</span>
            <span>RM @Model.Course.Price.ToString("0.00")</span>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const coursePrice = "@Model.Course.Price.ToString("0.00")";

    // ---- Tab switching ----
    function switchPayTab(tab) {
        $('.pay-tab').removeClass('active');
        if (tab === 'card') {
            $('#tabCardBtn').addClass('active');
            $('#cardPanel').show();
            $('#walletPanel').hide();
        } else {
            $('#tabWalletBtn').addClass('active');
            $('#walletPanel').show();
            $('#cardPanel').hide();
        }
    }

    // Auto-format card number with spaces
    $('#cardNumber').on('input', function () {
        let v = $(this).val().replace(/\D/g, '').slice(0, 16);
        $(this).val(v.replace(/(.{4})/g, '$1 ').trim());
    });

    // Auto-format expiry as MM/YY
    $('#cardExpiry').on('input', function () {
        let v = $(this).val().replace(/\D/g, '').slice(0, 4);
        if (v.length > 2) v = v.slice(0, 2) + '/' + v.slice(2);
        $(this).val(v);
    });

    $('#cardCvv').on('input', function () {
        $(this).val($(this).val().replace(/\D/g, '').slice(0, 4));
    });

    $('#walletPhone').on('input', function () {
        $(this).val($(this).val().replace(/\D/g, '').slice(0, 11));
    });

    // ---- Shared enroll call, used once "payment" (card or wallet) succeeds ----
    function finalizeEnrollment(courseId, $btn, resetLabel) {
        $.ajax({
            url: '/api/api/courses/enroll',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ courseId: courseId }),
            success: function (response) {
                if (response.success) {
                    showToast('Payment successful! You are enrolled 🎉', 'success');
                    setTimeout(() => {
                        location.href = '/CoursesDetails?id=' + courseId;
                    }, 1200);
                } else {
                    showToast(response.message || 'Enrollment failed', 'error');
                    $btn.prop('disabled', false).text(resetLabel);
                }
            },
            error: function () {
                showToast('Payment failed. Please try again.', 'error');
                $btn.prop('disabled', false).text(resetLabel);
            }
        });
    }

    // ---- Card payment (dummy) ----
    function submitCardPayment(courseId) {
        let valid = true;
        $('.form-error').removeClass('show');

        const name = $('#cardName').val().trim();
        const number = $('#cardNumber').val().replace(/\s/g, '');
        const expiry = $('#cardExpiry').val().trim();
        const cvv = $('#cardCvv').val().trim();

        if (name.length < 2) { $('#cardNameErr').addClass('show'); valid = false; }
        if (!/^\d{16}$/.test(number)) { $('#cardNumberErr').addClass('show'); valid = false; }
        if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry)) { $('#cardExpiryErr').addClass('show'); valid = false; }
        if (!/^\d{3,4}$/.test(cvv)) { $('#cardCvvErr').addClass('show'); valid = false; }

        if (!valid) return;

        const $btn = $('#payBtnCard');
        const resetLabel = 'Pay RM ' + coursePrice;
        $btn.prop('disabled', true).text('Processing payment...');

        // Simulate payment processing delay, then enroll the user.
        setTimeout(function () {
            finalizeEnrollment(courseId, $btn, resetLabel);
        }, 900);
    }

    // ---- E-Wallet payment (dummy) ----
    function submitWalletPayment(courseId) {
        $('.form-error').removeClass('show');

        const phone = $('#walletPhone').val().trim();
        if (!/^0\d{8,10}$/.test(phone)) {
            $('#walletPhoneErr').addClass('show');
            return;
        }

        const provider = $('#walletProvider option:selected').text();
        const $btn = $('#payBtnWallet');
        const resetLabel = 'Pay RM ' + coursePrice + ' with E-Wallet';

        $btn.prop('disabled', true).text('Redirecting to ' + provider + '...');
        $('#walletQrBox').show();
        $('#walletStatusText').text('Waiting for approval in your ' + provider + ' app...');

        // Simulate: redirect to provider -> user approves in-app -> callback confirms payment.
        setTimeout(function () {
            $('#walletStatusText').text('Payment approved! Finalizing enrollment...');
            $btn.text('Confirming...');

            setTimeout(function () {
                finalizeEnrollment(courseId, $btn, resetLabel);
            }, 700);
        }, 1600);
    }
</script>
}

