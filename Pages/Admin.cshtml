@page
@model APLH.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Admin Dashboard</h1>
            <p>Manage course content in the system.</p>
        </div>

        <button class="btn btn-primary" onclick="openAddCourseModal()">
            + Add Course
        </button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:25px; align-items:start;">

        <div class="admin-table-card"
             onclick="openModal('courseManagementModal')"
             style="cursor:pointer; min-height:320px; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center;">

            <h2>Course Management</h2>
            <p style="color:var(--text2); margin-top:10px;">
                Click here to manage, edit, and delete courses.
            </p>

        </div>

        <div class="admin-table-card">
            <h2>Course Statistics</h2>

            <div style="padding:20px; max-width:450px; margin:auto;">
                <canvas id="courseCountChart"></canvas>
            </div>
        </div>

    </div>

</div>

<div class="modal-overlay" id="courseManagementModal">
    <div class="modal" style="max-width:1100px; max-height:90vh; overflow-y:auto;">

        <h2>Course <span>Management</span></h2>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Emoji</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Level</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td>@course.Emoji</td>
                        <td>@course.Title</td>
                        <td>@course.Category</td>
                        <td>@course.Level</td>
                        <td>RM @course.Price</td>
                        <td>@course.Duration minutes</td>
                        <td>
                            <button class="icon-btn edit-btn"
                                    data-id="@course.Id"
                                    data-title="@course.Title"
                                    data-description="@course.Description"
                                    data-category="@course.Category"
                                    data-level="@course.Level"
                                    data-price="@course.Price"
                                    data-duration="@course.Duration"
                                    data-emoji="@course.Emoji">
                                Edit
                            </button>

                            <button class="icon-btn del"
                                    onclick="deleteCourse(@course.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="modal-actions">
            <button class="btn btn-ghost" onclick="closeModal('courseManagementModal')">
                Close
            </button>
        </div>

    </div>
</div>

@section Scripts {

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    function openAddCourseModal() {
        document.getElementById('courseModalTitle').innerHTML = 'Add <span>Course</span>';
        document.getElementById('courseEditId').value = 0;
        document.getElementById('courseTitle').value = '';
        document.getElementById('courseDesc').value = '';
        document.getElementById('courseCat').value = 'Technology';
        document.getElementById('courseLevel').value = 'Beginner';
        document.getElementById('coursePrice').value = 0;
        document.getElementById('courseDuration').value = 30;
        document.getElementById('courseEmoji').value = '📚';

        openModal('courseModal');
    }

    function editCourse(id, title, desc, category, level, price, duration, emoji) {
        closeModal('courseManagementModal');

        document.getElementById('courseModalTitle').innerHTML = 'Edit <span>Course</span>';
        document.getElementById('courseEditId').value = id;
        document.getElementById('courseTitle').value = title;
        document.getElementById('courseDesc').value = desc;
        document.getElementById('courseCat').value = category;
        document.getElementById('courseLevel').value = level;
        document.getElementById('coursePrice').value = price;
        document.getElementById('courseDuration').value = duration;
        document.getElementById('courseEmoji').value = emoji;

        openModal('courseModal');
    }

    function deleteCourse(id) {
        if (!confirm('Are you sure you want to delete this course?')) return;

        $.ajax({
            url: `/api/api/courses/${id}`,
            type: 'DELETE',
            success: function(response) {
                if (response.success) {
                    showToast('Course deleted successfully', 'success');
                    setTimeout(() => {
                        location.reload();
                    }, 800);
                } else {
                    showToast(response.message || 'Delete failed', 'error');
                }
            },
            error: function() {
                showToast('Server error while deleting course', 'error');
            }
        });
    }

    $(document).on('click', '.edit-btn', function () {
        const btn = $(this);

        editCourse(
            btn.data('id'),
            btn.data('title'),
            btn.data('description'),
            btn.data('category'),
            btn.data('level'),
            btn.data('price'),
            btn.data('duration'),
            btn.data('emoji')
        );
    });

    const courseNames = [
        @Html.Raw(string.Join(",", Model.Courses.Select(c => $"'{c.Title}'")))
    ];

    const courseValues = [
        @Html.Raw(string.Join(",", Model.Courses.Select(c => c.Enrolled)))
    ];

    const courseColors = [
        '#ff6b6b',
        '#6bcbff',
        '#ffd93d',
        '#4ade80',
        '#a78bfa',
        '#fb923c',
        '#22d3ee',
        '#f472b6'
    ];

    const totalStudents = courseValues.reduce((a, b) => a + b, 0);

    const courseCountChart = new Chart(document.getElementById('courseCountChart'), {
        type: 'pie',
        data: {
            labels: courseNames.map((name, index) => {
                const percentage = totalStudents === 0
                    ? 0
                    : ((courseValues[index] / totalStudents) * 100).toFixed(1);

                return `${name} (${percentage}%)`;
            }),
            datasets: [{
                label: 'Students Enrolled',
                data: courseValues,
                backgroundColor: courseColors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>

}