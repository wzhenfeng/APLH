@page
@model APLH.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Admin Dashboard</h1>
            <p>Manage the system.</p>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:25px; align-items:start;">

        <div class="admin-table-card"
             onclick="location.href='/CourseManagement'"
             style="cursor:pointer; min-height:320px; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center;">

            <h2>Course Management</h2>
            <p style="color:var(--text2); margin-top:10px;">
                Click here to manage, edit, add and delete courses.
            </p>
        </div>

        <div class="admin-table-card"
             onclick="location.href='/UserManagement'"
             style="cursor:pointer; min-height:320px; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center;">

            <h2>User Management</h2>
            <p style="color:var(--text2); margin-top:10px;">
                Click here to manage student accounts.
            </p>
        </div>

        <div class="admin-table-card">
            <h2>Course Statistics</h2>

            <div style="padding:20px; max-width:450px; margin:auto;">
                <canvas id="courseCountChart"></canvas>
            </div>
        </div>

    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const courseNames = [
        @Html.Raw(string.Join(",", Model.Courses.Select(c => $"'{c.Title}'")))
    ];

    const courseValues = [
        @Html.Raw(string.Join(",", Model.Courses.Select(c => c.Enrolled)))
    ];

    const totalStudents = courseValues.reduce((a, b) => a + b, 0);

    new Chart(document.getElementById('courseCountChart'), {
        type: 'pie',
        data: {
            labels: courseNames.map((name, index) => {
                const percentage = totalStudents === 0
                    ? 0
                    : ((courseValues[index] / totalStudents) * 100).toFixed(1);

                return `${name} (${percentage}%)`;
            }),
            datasets: [{
                label: 'Students Enrolled',
                data: courseValues
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>
}