@page "/CourseManagement"
@model APLH.Pages.CourseManagementModel
@{
    ViewData["Title"] = "Course Management";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>Course Management</h1>
            <p>Manage, edit, add and delete courses.</p>
        </div>

        <button class="btn btn-primary" onclick="openAddCourseModal()">
            + Add Course
        </button>
    </div>

    <div class="admin-table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Emoji</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Level</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td>@course.Emoji</td>
                        <td>@course.Title</td>
                        <td>@course.Category</td>
                        <td>@course.Level</td>
                        <td>RM @course.Price</td>
                        <td>@course.Duration minutes</td>
                        <td>
                            <button class="icon-btn edit-btn"
                                    data-id="@course.Id"
                                    data-title="@course.Title"
                                    data-description="@course.Description"
                                    data-category="@course.Category"
                                    data-level="@course.Level"
                                    data-price="@course.Price"
                                    data-duration="@course.Duration"
                                    data-emoji="@course.Emoji">
                                Edit
                            </button>

                            <button class="icon-btn"
                                    style="border-color:rgba(99,102,241,0.4);color:#818cf8;"
                                    onclick="openMaterialsModal(@course.Id, '@course.Title.Replace("'", "\\'")') ">
                                Materials
                            </button>

                            <button class="icon-btn del" onclick="deleteCourse(@course.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- ===== MATERIALS MODAL ===== -->
<div class="modal-overlay" id="materialsModal">
    <div class="modal" style="max-width:680px; max-height:90vh; overflow-y:auto;">

        <h2>Materials — <span id="matCourseTitle" style="color:var(--accent)"></span></h2>
        <input type="hidden" id="matCourseId">

        <!-- Chapter selector bar -->
        <div style="display:flex; align-items:center; gap:10px; margin:16px 0 10px; flex-wrap:wrap;">
            <label style="font-size:13px; color:var(--text2); white-space:nowrap;">Select Chapter:</label>
            <select id="chapterSelect"
                    onchange="onChapterSelected()"
                    style="flex:1; min-width:160px; padding:8px 12px; border-radius:var(--radius-sm);
                           border:1px solid var(--border2); background:var(--bg2); color:var(--text);
                           font-family:var(--font-body); font-size:14px;">
                <option value="">— choose a chapter —</option>
            </select>
            <button class="btn btn-ghost btn-sm" onclick="openNewChapterForm()">+ New Chapter</button>
        </div>

        <!-- New chapter form (hidden by default) -->
        <div id="newChapterForm" style="display:none; background:var(--bg2); border:1px solid var(--border);
             border-radius:var(--radius-sm); padding:14px; margin-bottom:12px;">
            <div style="font-size:13px; font-weight:600; margin-bottom:10px;">New Chapter</div>
            <div class="form-group" style="margin-bottom:10px;">
                <label>Chapter Title</label>
                <input type="text" id="newChapterTitle" placeholder="e.g. Introduction to Python">
            </div>
            <div style="display:flex; gap:8px;">
                <button class="btn btn-primary btn-sm" onclick="createNewChapter()">Create Chapter</button>
                <button class="btn btn-ghost btn-sm" onclick="document.getElementById('newChapterForm').style.display='none'">Cancel</button>
            </div>
        </div>

        <!-- Chapter editing area -->
        <div id="chapterEditArea" style="display:none;">

            <!-- Chapter title edit -->
            <div style="background:var(--bg2); border:1px solid var(--border);
                 border-radius:var(--radius-sm); padding:14px; margin-bottom:16px;">
                <div style="font-size:13px; font-weight:600; color:var(--text2); margin-bottom:8px;">Chapter Title</div>
                <div style="display:flex; gap:8px;">
                    <input type="text" id="editChapterTitle"
                           style="flex:1; padding:8px 12px; border-radius:var(--radius-sm);
                                  border:1px solid var(--border2); background:var(--surface);
                                  color:var(--text); font-family:var(--font-body); font-size:14px;">
                    <button class="btn btn-primary btn-sm" onclick="saveChapterTitle()">Save</button>
                </div>
            </div>

            <!-- Materials list -->
            <div id="materialsList"></div>

            <!-- Add new material button -->
            <button class="btn btn-ghost btn-sm" style="width:100%; margin-top:4px;"
                    onclick="addNewMaterialRow()">+ Add Material</button>
        </div>

        <div id="matPlaceholder" style="text-align:center; color:var(--text2); padding:40px 0; font-size:14px;">
            Select a chapter above to manage its materials.
        </div>

        <div class="modal-actions" style="margin-top:20px;">
            <button class="btn btn-ghost" onclick="closeModal('materialsModal')">Close</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Course modal ──────────────────────────────────────────
    function openAddCourseModal() {
        document.getElementById('courseModalTitle').innerHTML = 'Add <span>Course</span>';
        document.getElementById('courseEditId').value = 0;
        document.getElementById('courseTitle').value = '';
        document.getElementById('courseDesc').value = '';
        document.getElementById('courseCat').value = 'Technology';
        document.getElementById('courseLevel').value = 'Beginner';
        document.getElementById('coursePrice').value = 0;
        document.getElementById('courseDuration').value = 30;
        document.getElementById('courseEmoji').value = '📚';
        openModal('courseModal');
    }

    function editCourse(id, title, desc, category, level, price, duration, emoji) {
        document.getElementById('courseModalTitle').innerHTML = 'Edit <span>Course</span>';
        document.getElementById('courseEditId').value = id;
        document.getElementById('courseTitle').value = title;
        document.getElementById('courseDesc').value = desc;
        document.getElementById('courseCat').value = category;
        document.getElementById('courseLevel').value = level;
        document.getElementById('coursePrice').value = price;
        document.getElementById('courseDuration').value = duration;
        document.getElementById('courseEmoji').value = emoji;
        openModal('courseModal');
    }

    $(document).on('click', '.edit-btn', function () {
        const btn = $(this);
        editCourse(
            btn.data('id'), btn.data('title'), btn.data('description'),
            btn.data('category'), btn.data('level'), btn.data('price'),
            btn.data('duration'), btn.data('emoji')
        );
    });

    function deleteCourse(id) {
        if (!confirm('Are you sure you want to delete this course?')) return;
        $.ajax({
            url: `/api/api/courses/${id}`, type: 'DELETE',
            success: function(r) {
                if (r.success) { showToast('Course deleted successfully', 'success'); setTimeout(() => location.reload(), 800); }
                else showToast(r.message || 'Delete failed', 'error');
            },
            error: function() { showToast('Server error while deleting course', 'error'); }
        });
    }

    // ── Materials modal ───────────────────────────────────────
    let _chapters = [];   // { chapterOrder, chapterTitle, materials[] }

    function openMaterialsModal(courseId, courseTitle) {
        document.getElementById('matCourseId').value = courseId;
        document.getElementById('matCourseTitle').textContent = courseTitle;
        document.getElementById('newChapterForm').style.display = 'none';
        document.getElementById('chapterEditArea').style.display = 'none';
        document.getElementById('matPlaceholder').style.display = 'block';
        document.getElementById('chapterSelect').innerHTML = '<option value="">— choose a chapter —</option>';
        _chapters = [];

        openModal('materialsModal');
        loadChapters(courseId);
    }

    function loadChapters(courseId) {
        $.getJSON(`/api/api/materials/${courseId}`, function(materials) {
            // Group by chapterOrder
            const map = {};
            materials.forEach(m => {
                const key = m.chapterOrder;
                if (!map[key]) map[key] = { chapterOrder: m.chapterOrder, chapterTitle: m.chapterTitle, materials: [] };
                map[key].materials.push(m);
            });
            _chapters = Object.values(map).sort((a,b) => a.chapterOrder - b.chapterOrder);

            const sel = document.getElementById('chapterSelect');
            sel.innerHTML = '<option value="">— choose a chapter —</option>';
            _chapters.forEach((ch, idx) => {
                const label = ch.chapterTitle ? `Chapter ${ch.chapterOrder}: ${ch.chapterTitle}` : `Chapter ${ch.chapterOrder}`;
                sel.innerHTML += `<option value="${idx}">${label}</option>`;
            });
        });
    }

    function onChapterSelected() {
        const idx = document.getElementById('chapterSelect').value;
        if (idx === '') {
            document.getElementById('chapterEditArea').style.display = 'none';
            document.getElementById('matPlaceholder').style.display = 'block';
            return;
        }
        document.getElementById('matPlaceholder').style.display = 'none';
        document.getElementById('chapterEditArea').style.display = 'block';
        renderChapterEditor(parseInt(idx));
    }

    function renderChapterEditor(idx) {
        const ch = _chapters[idx];
        document.getElementById('editChapterTitle').value = ch.chapterTitle || '';
        document.getElementById('editChapterTitle').dataset.chapterOrder = ch.chapterOrder;

        const list = document.getElementById('materialsList');
        list.innerHTML = '';
        ch.materials.forEach(m => list.appendChild(buildMaterialCard(m)));
    }

    function buildMaterialCard(m) {
        const div = document.createElement('div');
        div.dataset.materialId = m.id;
        div.dataset.chapterOrder = m.chapterOrder;
        div.style.cssText = 'background:var(--bg2); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px; margin-bottom:12px;';

        div.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <span style="font-size:13px; font-weight:600; color:var(--text2);">Material</span>
                <button class="icon-btn del" onclick="deleteMaterial(this, ${m.id})">Delete</button>
            </div>
            <div class="form-group" style="margin-bottom:8px;">
                <label>Title</label>
                <input type="text" class="mat-title" value="${escHtml(m.title)}"
                       style="width:100%; padding:8px 12px; border-radius:var(--radius-sm);
                              border:1px solid var(--border2); background:var(--surface);
                              color:var(--text); font-family:var(--font-body); font-size:14px; box-sizing:border-box;">
            </div>
            <div class="form-group" style="margin-bottom:8px;">
                <label>Content</label>
                <textarea class="mat-content" rows="3"
                          style="width:100%; padding:8px 12px; border-radius:var(--radius-sm);
                                 border:1px solid var(--border2); background:var(--surface);
                                 color:var(--text); font-family:var(--font-body); font-size:14px;
                                 resize:vertical; box-sizing:border-box;">${escHtml(m.content)}</textarea>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:10px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label>Image URL</label>
                    <input type="text" class="mat-image" value="${escHtml(m.imageUrl)}"
                           placeholder="https://..."
                           style="width:100%; padding:8px 12px; border-radius:var(--radius-sm);
                                  border:1px solid var(--border2); background:var(--surface);
                                  color:var(--text); font-family:var(--font-body); font-size:13px; box-sizing:border-box;">
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label>Video URL</label>
                    <input type="text" class="mat-video" value="${escHtml(m.videoUrl)}"
                           placeholder="https://youtube.com/embed/..."
                           style="width:100%; padding:8px 12px; border-radius:var(--radius-sm);
                                  border:1px solid var(--border2); background:var(--surface);
                                  color:var(--text); font-family:var(--font-body); font-size:13px; box-sizing:border-box;">
                </div>
            </div>
            <div style="text-align:right;">
                <button class="btn btn-primary btn-sm" onclick="saveMaterial(this)">Save Material</button>
            </div>`;
        return div;
    }

    function escHtml(str) {
        return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    // ── Chapter title save ────────────────────────────────────
    function saveChapterTitle() {
        const courseId = parseInt(document.getElementById('matCourseId').value);
        const chapterOrder = parseInt(document.getElementById('editChapterTitle').dataset.chapterOrder);
        const newTitle = document.getElementById('editChapterTitle').value.trim();

        // Find all materials in this chapter and resave them with new chapterTitle
        const ch = _chapters.find(c => c.chapterOrder === chapterOrder);
        if (!ch || ch.materials.length === 0) {
            showToast('No materials to update in this chapter', 'error');
            return;
        }

        const saves = ch.materials.map(m =>
            $.ajax({ url: '/api/api/materials/save', type: 'POST',
                     contentType: 'application/json',
                     data: JSON.stringify({ ...m, chapterTitle: newTitle }) })
        );

        Promise.all(saves.map(p => p.promise ? p.promise() : p)).then(() => {
            ch.chapterTitle = newTitle;
            // Update dropdown label
            const sel = document.getElementById('chapterSelect');
            const selectedOpt = sel.options[sel.selectedIndex];
            selectedOpt.textContent = `Chapter ${chapterOrder}: ${newTitle}`;
            showToast('Chapter title saved', 'success');
        }).catch(() => showToast('Failed to save chapter title', 'error'));
    }

    // ── Save single material ──────────────────────────────────
    function saveMaterial(btn) {
        const card = btn.closest('[data-material-id]');
        const courseId = parseInt(document.getElementById('matCourseId').value);
        const chapterOrder = parseInt(card.dataset.chapterOrder);
        const chapterTitle = document.getElementById('editChapterTitle').value.trim();

        const payload = {
            id: parseInt(card.dataset.materialId),
            courseId: courseId,
            chapterOrder: chapterOrder,
            chapterTitle: chapterTitle,
            title: card.querySelector('.mat-title').value.trim(),
            content: card.querySelector('.mat-content').value.trim(),
            imageUrl: card.querySelector('.mat-image').value.trim(),
            videoUrl: card.querySelector('.mat-video').value.trim()
        };

        $.ajax({
            url: '/api/api/materials/save', type: 'POST', contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(r) {
                if (r.success) {
                    showToast('Material saved', 'success');
                    if (payload.id === 0) {
                        // Refresh so we get the new ID assigned
                        loadChapters(courseId);
                        setTimeout(() => {
                            // Re-select the same chapter
                            const sel = document.getElementById('chapterSelect');
                            const targetOrder = chapterOrder;
                            for (let i = 0; i < sel.options.length; i++) {
                                const ch = _chapters[parseInt(sel.options[i].value)];
                                if (ch && ch.chapterOrder === targetOrder) {
                                    sel.selectedIndex = i;
                                    onChapterSelected();
                                    break;
                                }
                            }
                        }, 300);
                    }
                } else showToast('Save failed', 'error');
            },
            error: function() { showToast('Server error', 'error'); }
        });
    }

    // ── Delete material ───────────────────────────────────────
    function deleteMaterial(btn, id) {
        if (!confirm('Delete this material?')) return;
        if (id === 0) { btn.closest('[data-material-id]').remove(); return; }
        $.ajax({
            url: `/api/api/materials/${id}`, type: 'DELETE',
            success: function(r) {
                if (r.success || r === '') {
                    btn.closest('[data-material-id]').remove();
                    showToast('Material deleted', 'success');
                    const courseId = parseInt(document.getElementById('matCourseId').value);
                    loadChapters(courseId);
                } else showToast('Delete failed', 'error');
            },
            error: function() {
                // Some APIs return 200 with empty body; treat as success
                btn.closest('[data-material-id]').remove();
                showToast('Material deleted', 'success');
                const courseId = parseInt(document.getElementById('matCourseId').value);
                loadChapters(courseId);
            }
        });
    }

    // ── Add new material row ──────────────────────────────────
    function addNewMaterialRow() {
        const sel = document.getElementById('chapterSelect');
        if (sel.value === '') return;
        const ch = _chapters[parseInt(sel.value)];

        const blank = { id: 0, courseId: parseInt(document.getElementById('matCourseId').value),
                        chapterOrder: ch.chapterOrder, chapterTitle: ch.chapterTitle || '',
                        title: '', content: '', imageUrl: '', videoUrl: '' };
        const card = buildMaterialCard(blank);
        document.getElementById('materialsList').appendChild(card);
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ── New chapter creation ──────────────────────────────────
    function openNewChapterForm() {
        document.getElementById('newChapterTitle').value = '';
        document.getElementById('newChapterForm').style.display = 'block';
    }

    function createNewChapter() {
        const title = document.getElementById('newChapterTitle').value.trim();
        if (!title) { showToast('Please enter a chapter title', 'error'); return; }

        const courseId = parseInt(document.getElementById('matCourseId').value);
        const nextOrder = _chapters.length > 0 ? Math.max(..._chapters.map(c => c.chapterOrder)) + 1 : 1;

        // Create one placeholder material to establish the chapter
        const payload = {
            id: 0, courseId: courseId,
            chapterOrder: nextOrder, chapterTitle: title,
            title: 'New Material', content: '', imageUrl: '', videoUrl: ''
        };

        $.ajax({
            url: '/api/api/materials/save', type: 'POST', contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(r) {
                if (r.success) {
                    document.getElementById('newChapterForm').style.display = 'none';
                    showToast('Chapter created', 'success');
                    loadChapters(courseId);
                    // Auto-select the new chapter after a short delay
                    setTimeout(() => {
                        const sel = document.getElementById('chapterSelect');
                        for (let i = 1; i < sel.options.length; i++) {
                            const ch = _chapters[parseInt(sel.options[i].value)];
                            if (ch && ch.chapterOrder === nextOrder) {
                                sel.selectedIndex = i;
                                onChapterSelected();
                                break;
                            }
                        }
                    }, 400);
                } else showToast('Failed to create chapter', 'error');
            },
            error: function() { showToast('Server error', 'error'); }
        });
    }
</script>
}
