@page
@model CoursesModel
@{
    ViewData["Title"] = "Courses - APLH";
}

<div class="page-header">
    <div style="max-width:1200px;margin:0 auto">
        <h1>All Courses</h1>
        <p>Explore our catalog — from beginner to advanced, across every field.</p>
    </div>
</div>

<div class="courses-container">
    <div class="courses-toolbar">
        <div class="search-box">
            <input type="text" id="courseSearch" placeholder="Search courses..." onkeyup="loadCourses()">
        </div>
        <div class="category-filters" id="categoryFilters">
            <button class="filter-btn active" onclick="filterCourses('all', this)">All</button>
        </div>
        <button class="btn btn-primary btn-sm" id="addCourseBtn" style="display:none; margin-left:auto" onclick="openAddCourseModal()">+ Add Course</button>
    </div>
    <div id="coursesGrid" class="courses-grid"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadCategoryFilters();
            loadCourses();
            checkAdminAccess();
        });

        function loadCategoryFilters() {
            $.ajax({
                url: '/api/api/courses/categories',
                type: 'GET',
                success: function(categories) {
                    const container = $('#categoryFilters');
                    const buttons = (categories || []).map(cat => {
                        const safe = $('<div>').text(cat).html();
                        return `<button class="filter-btn" onclick="filterCourses('${safe.replace(/'/g, "\\'")}', this)">${safe}</button>`;
                    }).join('');
                    container.html(`<button class="filter-btn active" onclick="filterCourses('all', this)">All</button>${buttons}`);
                },
                error: function() {
                    // Fall back to just the "All" button if categories fail to load.
                    $('#categoryFilters').html(`<button class="filter-btn active" onclick="filterCourses('all', this)">All</button>`);
                }
            });
        }

        function checkAdminAccess() {
            $.ajax({
                url: '/api/api/auth/currentuser',
                type: 'GET',
                success: function(user) {
                    if (user && (user.role === 'admin' || user.Role === 'admin')) {
                        $('#addCourseBtn').show();
                    }
                }
            });
        }

        function openAddCourseModal() {
            $('#courseModalTitle').html('Add <span>Course</span>');
            $('#courseEditId').val('');
            $('#courseTitle').val('');
            $('#courseDesc').val('');
            $('#courseLevel').val('Beginner');
            $('#coursePrice').val(0);
            $('#courseDuration').val(8);
            $('#courseEmoji').val('📚');
            loadCourseCategories('Technology').always(function () {
                openModal('courseModal');
            });
        }
    </script>
}