@page
@model CourseDetailModel
@{
    ViewData["Title"] = Model.Course?.Title + " - APLH";
}

@if (Model.Course != null)
{
    var enrolled = Model.IsEnrolled;
    
    <div class="course-detail-layout">
        <div class="course-detail-main">
            <div class="course-detail-thumb" style="background: @Model.GetCategoryBg()">
                @Model.Course.Emoji
            </div>
            <div class="course-cat" style="color:@Model.GetCategoryColor(); font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:0.5rem">
                @Model.Course.Category · @Model.Course.Level
            </div>
            <div class="course-detail-title">@Model.Course.Title</div>
            <div class="course-detail-desc">@Model.Course.Description</div>
            <div style="display:flex; gap:1.5rem; margin-bottom:1.5rem; font-size:0.875rem; color:var(--text2)">
                <span>⏱ @Model.Course.Duration minutes</span>
                <span>⭐ @Model.Course.Rating rating</span>
                <span>👥 @Model.Course.Enrolled.ToLocaleString() students</span>
            </div>
            <div class="curriculum">
                <div class="curriculum-header" style="display:flex; align-items:center; justify-content:space-between;">
                    <span>📋 Course Curriculum</span>
                    @if (User.IsInRole("admin"))
                    {
                        <a href="#" style="font-size:0.8125rem; font-weight:600; color:var(--accent3); text-decoration:none;"
                        onclick="openMaterialModal(); return false;">
                            + Add Chapter
                        </a>
                    }
                </div>
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="curriculum-item">
                        <span>Module @i: @Model.GetModuleName(i)</span>
                        <span style="color:var(--text3)">@(Model.Course.Duration / 6 + (i == 1 ? 2 : 0)) minutes</span>
                    </div>
                }
            </div>
        </div>
        <div class="course-detail-sidebar">
            <div class="sticky-sidebar">
                <div class="sidebar-card">
                    <div class="sidebar-price @(Model.Course.Price == 0 ? "free" : "")">
                        @(Model.Course.Price == 0 ? "FREE" : "RM " + Model.Course.Price)
                    </div>
                    @if (User.IsInRole("admin"))
                        {
                            <button class="btn btn-ghost"
                                    style="width:100%; padding:14px; font-size:1rem; margin-bottom:10px;"
                                    onclick="openMaterialModal()">
                                Add / Edit Materials
                            </button>
                            
                            <button class="btn btn-primary"
                                    style="width:100%; padding:14px; font-size:1rem"
                                    onclick="openQuizQuestionModal()">
                                Add / Edit Quiz Questions
                            </button>
                        }
                        else if (enrolled)
                        {
                            <button class="btn btn-success"
                                    style="width:100%; padding:14px; font-size:1rem"
                                    onclick="location.href='/Learning?courseId=@Model.Course.Id'">

                                Continue Learning →

                            </button>

                            <p style="color:var(--green); text-align:center; margin-top:8px; font-size:0.875rem">
                                ✓ You are enrolled!
                            </p>
                        }
                        else
                        {
                            <button class="btn btn-primary"
                                    style="width:100%; padding:14px; font-size:1rem"
                                    onclick="enrollCourse(@Model.Course.Id)">

                                @(Model.Course.Price == 0 ? "Enroll for Free" : "Enroll Now")

                            </button>
                        }
                    <div class="sidebar-includes">
                        <div>📹 @Model.Course.Duration minutes of video content</div>
                        <div>📝 Quizzes and assessments</div>
                        <div>🏆 Certificate of completion</div>
                        <div>♾ Full lifetime access</div>
                        <div>📱 Access on mobile & desktop</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="icon">🔍</div>
        <p>Course not found.</p>
    </div>
}

<div class="modal-overlay" id="quizQuestionModal">
    <div class="modal" style="max-width:700px;">
        <h2>Manage <span>Quiz Questions</span></h2>

        <!-- STAGE 1: pick a chapter -->
        <div id="quizChapterStage">
            <div class="form-group">
                <label>Select Chapter</label>
                <select id="quizChapterSelect">
                    <option value="">-- Select a chapter --</option>
                </select>
            </div>

            <div id="newChapterFields" style="display:none;">
                <div style="display:flex;gap:12px;">
                    <div class="form-group" style="flex:0 0 120px;">
                        <label>Chapter No.</label>
                        <input type="number" id="newChapterOrder" min="1" value="1">
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label>Chapter Title</label>
                        <input type="text" id="newChapterTitle" placeholder="e.g. Introduction">
                    </div>
                </div>
            </div>

            <p id="quizNoChapterHint" style="display:none; font-size:0.8125rem; color:var(--text3); margin-top:-0.5rem;">
                This course has no chapters yet. Add materials first, or create a new chapter above.
            </p>

            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="proceedToQuizQuestions()">
                    Next →
                </button>

                <button class="btn btn-ghost" onclick="closeModal('quizQuestionModal')">
                    Cancel
                </button>
            </div>
        </div>

        <!-- STAGE 2: edit questions inside the selected chapter -->
        <div id="quizQuestionsStage" style="display:none;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.25rem;">
                <button class="btn btn-ghost btn-sm" onclick="backToChapterStage()">← Back</button>
                <span class="quiz-chapter-badge" id="quizChapterBadge"></span>
            </div>

            <div id="quizQuestionList"></div>

            <button class="btn btn-ghost" onclick="addQuestionForm()">
                + Add Another Question
            </button>

            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="saveAllQuizQuestions()">
                    Save All Questions
                </button>

                <button class="btn btn-ghost" onclick="closeModal('quizQuestionModal')">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="materialModal">
    <div class="modal" style="max-width:750px; max-height:90vh; overflow-y:auto;">
        <h2>Add / Edit <span>Materials</span></h2>

        <div id="materialList"></div>

        <button class="btn btn-ghost" onclick="addMaterialForm()">
            + Add Another Material
        </button>

        <div class="modal-actions">

            <button class="btn btn-primary"
                    style="flex:1"
                    onclick="saveAllMaterials()">

                Save All Materials

            </button>

            <button class="btn btn-ghost"
                    onclick="closeModal('materialModal')">

                Cancel

            </button>

        </div>
    </div>
</div>

@section Scripts {
<script>
    let questionIndex = 0;
    let allQuizQuestionsCache = [];
    let selectedChapter = null;
    const currentCourseId = @Model.Course.Id;

    function enrollCourse(courseId) {
        $.ajax({
            url: '/api/api/courses/enroll',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ courseId: courseId }),
            success: function(response) {
                if (response.success) {
                    showToast('Successfully enrolled! 🎉', 'success');
                    setTimeout(() => location.reload(), 1500);
                }
            },
            error: function() {
                openLoginModal();
            }
        });
    }

    function openQuizQuestionModal() {
        $('#quizQuestionList').html('');
        questionIndex = 0;
        selectedChapter = null;

        $('#newChapterFields').hide();
        $('#newChapterOrder').val(1);
        $('#newChapterTitle').val('');
        $('#quizQuestionsStage').hide();
        $('#quizChapterStage').show();
        $('#quizChapterSelect').html('<option value="">Loading chapters...</option>');
        $('#quizNoChapterHint').hide();

        openModal('quizQuestionModal');

        $.when(
            $.ajax({ url: `/api/api/materials/${currentCourseId}`, type: 'GET' }),
            $.ajax({ url: `/api/api/quiz/questions?courseId=${currentCourseId}`, type: 'GET' })
        ).done(function (materialsResp, quizResp) {
            const materials = materialsResp[0] || [];
            const questions = quizResp[0] || [];

            allQuizQuestionsCache = questions;

            // Build a unique list of chapters from materials + any chapters quiz questions already use
            const chapterMap = new Map();

            materials.forEach(m => {
                const order = m.chapterOrder || 1;
                if (!chapterMap.has(order)) {
                    chapterMap.set(order, m.chapterTitle || `Chapter ${order}`);
                }
            });

            questions.forEach(q => {
                const order = q.chapterOrder || 1;
                if (!chapterMap.has(order)) {
                    chapterMap.set(order, q.chapterTitle || `Chapter ${order}`);
                }
            });

            const sortedChapters = [...chapterMap.entries()]
                .map(([order, title]) => ({ order, title }))
                .sort((a, b) => a.order - b.order);

            let optionsHtml = '<option value="">-- Select a chapter --</option>';
            sortedChapters.forEach(ch => {
                const safeTitle = (ch.title || '').replace(/"/g, '&quot;');
                optionsHtml += `<option value="${ch.order}" data-title="${safeTitle}">Chapter ${ch.order}: ${ch.title}</option>`;
            });
            optionsHtml += '<option value="__new__">+ Create New Chapter</option>';

            $('#quizChapterSelect').html(optionsHtml);
            $('#quizNoChapterHint').toggle(sortedChapters.length === 0);

            const nextOrder = sortedChapters.length
                ? Math.max(...sortedChapters.map(c => c.order)) + 1
                : 1;
            $('#newChapterOrder').val(nextOrder);
        }).fail(function () {
            showToast('Failed to load chapters', 'error');
            $('#quizChapterSelect').html('<option value="__new__">+ Create New Chapter</option>');
        });
    }

    $(document).on('change', '#quizChapterSelect', function () {
        $('#newChapterFields').toggle($(this).val() === '__new__');
    });

    function proceedToQuizQuestions() {
        const val = $('#quizChapterSelect').val();

        if (!val) {
            showToast('Please select a chapter', 'error');
            return;
        }

        if (val === '__new__') {
            const order = parseInt($('#newChapterOrder').val());
            const title = $('#newChapterTitle').val().trim();

            if (!order || !title) {
                showToast('Please enter the chapter number and title', 'error');
                return;
            }

            selectedChapter = { order, title };
        } else {
            const title = $('#quizChapterSelect option:selected').data('title') || `Chapter ${val}`;
            selectedChapter = { order: parseInt(val), title: title };
        }

        $('#quizChapterBadge').text(`Chapter ${selectedChapter.order}: ${selectedChapter.title}`);

        $('#quizQuestionList').html('');
        questionIndex = 0;

        const existing = allQuizQuestionsCache.filter(q => (q.chapterOrder || 1) === selectedChapter.order);

        if (existing.length === 0) {
            addQuestionForm();
        } else {
            existing.forEach(q => addExistingQuestionForm(q));
        }

        $('#quizChapterStage').hide();
        $('#quizQuestionsStage').show();
    }

    function backToChapterStage() {
        $('#quizQuestionsStage').hide();
        $('#quizChapterStage').show();
    }

    function addQuestionForm() {
        questionIndex++;

        $('#quizQuestionList').append(`
            <div class="quiz-question-form" style="border:1px solid var(--border);padding:15px;border-radius:12px;margin-bottom:15px;">
                <h3>Question ${questionIndex}</h3>

                <div class="form-group">
                    <label>Question</label>
                    <input type="text" class="q-question" placeholder="Enter question">
                </div>

                <div class="form-group">
                    <label>Option A</label>
                    <input type="text" class="q-option-a" placeholder="Option A">
                </div>

                <div class="form-group">
                    <label>Option B</label>
                    <input type="text" class="q-option-b" placeholder="Option B">
                </div>

                <div class="form-group">
                    <label>Option C</label>
                    <input type="text" class="q-option-c" placeholder="Option C">
                </div>

                <div class="form-group">
                    <label>Option D</label>
                    <input type="text" class="q-option-d" placeholder="Option D">
                </div>

                <div class="form-group">
                    <label>Correct Answer</label>
                    <select class="q-correct-answer">
                        <option value="0">Option A</option>
                        <option value="1">Option B</option>
                        <option value="2">Option C</option>
                        <option value="3">Option D</option>
                    </select>
                </div>

                <button class="btn btn-danger btn-sm"
                        style="margin-top:12px;"
                        onclick="removeQuestion(this)">
                    Remove Question
                </button>
            </div>
        `);
    }

    function addExistingQuestionForm(q) {
        questionIndex++;

        $('#quizQuestionList').append(`
            <div class="quiz-question-form" style="border:1px solid var(--border);padding:15px;border-radius:12px;margin-bottom:15px;">
                <h3>Question ${questionIndex}</h3>

                <input type="hidden" class="q-id" value="${q.id}">

                <div class="form-group">
                    <label>Question</label>
                    <input type="text" class="q-question" value="${q.question}">
                </div>

                <div class="form-group">
                    <label>Option A</label>
                    <input type="text" class="q-option-a" value="${q.optionA}">
                </div>

                <div class="form-group">
                    <label>Option B</label>
                    <input type="text" class="q-option-b" value="${q.optionB}">
                </div>

                <div class="form-group">
                    <label>Option C</label>
                    <input type="text" class="q-option-c" value="${q.optionC}">
                </div>

                <div class="form-group">
                    <label>Option D</label>
                    <input type="text" class="q-option-d" value="${q.optionD}">
                </div>

                <div class="form-group">
                    <label>Correct Answer</label>
                    <select class="q-correct-answer">
                        <option value="0" ${q.correctAnswer == 0 ? 'selected' : ''}>Option A</option>
                        <option value="1" ${q.correctAnswer == 1 ? 'selected' : ''}>Option B</option>
                        <option value="2" ${q.correctAnswer == 2 ? 'selected' : ''}>Option C</option>
                        <option value="3" ${q.correctAnswer == 3 ? 'selected' : ''}>Option D</option>
                    </select>
                </div>

                <button class="btn btn-danger btn-sm"
                        style="margin-top:12px;"
                        onclick="removeQuestion(this)">
                    Remove Question
                </button>
            </div>
        `);
    }

    function removeQuestion(button) {
    const form = $(button).closest('.quiz-question-form');
    const questionId = form.find('.q-id').val();

    if (!questionId) {
        form.remove();
        return;
    }

    if (!confirm('Remove this question permanently?')) return;

    $.ajax({
        url: `/api/api/quiz/questions/${questionId}`,
        type: 'DELETE',
        success: function(response) {
            if (response.success) {
                form.remove();
                showToast('Question removed successfully', 'success');
            } else {
                showToast('Failed to remove question', 'error');
            }
        },
        error: function() {
            showToast('Server error while removing question', 'error');
        }
    });
    }

    function saveAllQuizQuestions() {
        const forms = $('.quiz-question-form');

        if (forms.length === 0) {
            showToast('Please add at least one question', 'error');
            return;
        }

        if (!selectedChapter) {
            showToast('No chapter selected', 'error');
            return;
        }

        forms.each(function () {
            const form = $(this);

            const question = {
                id: parseInt(form.find('.q-id').val()) || 0,
                chapterOrder: selectedChapter.order,
                chapterTitle: selectedChapter.title,
                question: form.find('.q-question').val(),
                optionA: form.find('.q-option-a').val(),
                optionB: form.find('.q-option-b').val(),
                optionC: form.find('.q-option-c').val(),
                optionD: form.find('.q-option-d').val(),
                correctAnswer: parseInt(form.find('.q-correct-answer').val()),
                courseId: currentCourseId
            };

            $.ajax({
                url: '/api/api/quiz/questions/save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(question)
            });
        });

        showToast('All quiz questions saved successfully 🎉', 'success');

        setTimeout(() => {
            closeModal('quizQuestionModal');
            location.reload();
        }, 1000);
    }

    let materialIndex = 0;

function openMaterialModal() {
    $('#materialList').html('');
    materialIndex = 0;
    openModal('materialModal');

    $.ajax({
        url: `/api/api/materials/${currentCourseId}`,
        type: 'GET',
        success: function(materials) {
            if (!materials || materials.length === 0) {
                addMaterialForm();
                return;
            }

            materials.forEach(m => {
                addExistingMaterialForm(m);
            });
        },
        error: function() {
            showToast('Failed to load materials', 'error');
        }
    });
}

function addMaterialForm() {
    materialIndex++;

    $('#materialList').append(`
        <div class="material-form" style="border:1px solid var(--border); padding:15px; border-radius:12px; margin-bottom:15px;">
            <h3>Material ${materialIndex}</h3>

            <input type="hidden" class="material-id" value="0">

            <div style="display:flex;gap:12px;">
                <div class="form-group" style="flex:0 0 120px;">
                    <label>Chapter No.</label>
                    <input type="number" class="material-chapter-order" min="1" value="1" placeholder="1">
                </div>
                <div class="form-group" style="flex:1;">
                    <label>Chapter Title</label>
                    <input type="text" class="material-chapter-title" placeholder="e.g. Getting Started">
                </div>
            </div>

            <div class="form-group">
                <label>Material Title</label>
                <input type="text" class="material-title" placeholder="e.g. Introduction to HTML">
            </div>

            <div class="form-group">
                <label>Material Content</label>
                <textarea class="material-content" rows="8" placeholder="Type course notes here..."></textarea>
            </div>

            <div class="form-group">
                <label>Image URL</label>
                <input type="text" class="material-image-url" placeholder="Paste image link">
            </div>

            <div class="form-group">
                <label>Video URL</label>
                <input type="text" class="material-video-url" placeholder="Paste YouTube/video link">
            </div>
        </div>
    `);
}

function addExistingMaterialForm(m) {
    materialIndex++;

    $('#materialList').append(`
        <div class="material-form" style="border:1px solid var(--border); padding:15px; border-radius:12px; margin-bottom:15px;">
            <h3>Material ${materialIndex}</h3>

            <input type="hidden" class="material-id" value="${m.id}">

            <div style="display:flex;gap:12px;">
                <div class="form-group" style="flex:0 0 120px;">
                    <label>Chapter No.</label>
                    <input type="number" class="material-chapter-order" min="1" value="${m.chapterOrder || 1}" placeholder="1">
                </div>
                <div class="form-group" style="flex:1;">
                    <label>Chapter Title</label>
                    <input type="text" class="material-chapter-title" value="${m.chapterTitle || ''}" placeholder="e.g. Getting Started">
                </div>
            </div>

            <div class="form-group">
                <label>Material Title</label>
                <input type="text" class="material-title" value="${m.title || ''}">
            </div>

            <div class="form-group">
                <label>Material Content</label>
                <textarea class="material-content" rows="8">${m.content || ''}</textarea>
            </div>

            <div class="form-group">
                <label>Image URL</label>
                <input type="text" class="material-image-url" value="${m.imageUrl || ''}">
            </div>

            <div class="form-group">
                <label>Video URL</label>
                <input type="text" class="material-video-url" value="${m.videoUrl || ''}">
            </div>
        </div>
    `);
}

    function saveAllMaterials() {
    const forms = $('.material-form');

    if (forms.length === 0) {
        showToast('Please add at least one material', 'error');
        return;
    }

    forms.each(function () {
        const form = $(this);

        let videoUrl = form.find('.material-video-url').val();

        if (videoUrl.includes("watch?v=")) {
            videoUrl = videoUrl.replace("watch?v=", "embed/");
        } else if (videoUrl.includes("youtu.be/")) {
            videoUrl = videoUrl.replace("https://youtu.be/", "https://www.youtube.com/embed/");
        }

        const material = {
            id: parseInt(form.find('.material-id').val()) || 0,
            courseId: currentCourseId,
            chapterOrder: parseInt(form.find('.material-chapter-order').val()) || 1,
            chapterTitle: form.find('.material-chapter-title').val() || '',
            title: form.find('.material-title').val(),
            content: form.find('.material-content').val(),
            imageUrl: form.find('.material-image-url').val(),
            videoUrl: videoUrl
        };

        $.ajax({
            url: '/api/api/materials/save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(material)
        });
    });

    showToast('Materials saved successfully 🎉', 'success');

    setTimeout(() => {
        closeModal('materialModal');
        location.reload();
    }, 1000);
}
</script>
}