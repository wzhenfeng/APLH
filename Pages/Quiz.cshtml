@page
@model APLH.Pages.QuizModel
@{
    ViewData["Title"] = "Quiz";
}

<style>
    .quiz-layout {
        display: flex;
        gap: 24px;
        align-items: flex-start;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* ── Sidebar ── */
    .quiz-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 18px;
        padding: 20px;
        position: sticky;
        top: 24px;
    }

    .sidebar-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #555;
        font-weight: 600;
        margin-bottom: 14px;
    }

    .chapter-tab {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        margin-bottom: 4px;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

    .chapter-tab:hover { background: #1a1a1a; }

    .chapter-tab.active {
        background: #1e3a2f;
        border-color: #2d5a42;
    }

    .chapter-tab.done .tab-dot { background: #4ade80; }
    .chapter-tab.active .tab-dot { background: #4ade80; }

    .tab-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #333;
        flex-shrink: 0;
    }

    .tab-info { flex: 1; min-width: 0; }

    .tab-name {
        font-size: 13px;
        color: #ccc;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chapter-tab.active .tab-name { color: #fff; }

    .tab-count {
        font-size: 11px;
        color: #555;
        margin-top: 2px;
    }

    .chapter-tab.done .tab-name { color: #4ade80; }

    .sidebar-divider {
        border: none;
        border-top: 1px solid #1e1e1e;
        margin: 16px 0;
    }

    .sidebar-score-box {
        background: #0f1f17;
        border: 1px solid #1e3a2f;
        border-radius: 10px;
        padding: 12px;
        font-size: 13px;
        color: #888;
    }

    .sidebar-score-box strong { color: #4ade80; }

    /* ── Main ── */
    .quiz-main { flex: 1; min-width: 0; }

    .quiz-chapter-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .quiz-chapter-badge {
        background: #1e3a2f;
        border: 1px solid #2d5a42;
        color: #4ade80;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .quiz-chapter-title {
        font-size: 22px;
        font-weight: 600;
    }

    .quiz-progress-wrap { margin-bottom: 24px; }

    .quiz-progress-bg {
        background: #1e1e1e;
        border-radius: 999px;
        height: 6px;
        overflow: hidden;
    }

    .quiz-progress-fill {
        background: #4ade80;
        height: 100%;
        border-radius: 999px;
        transition: width 0.3s ease;
    }

    .quiz-progress-label {
        font-size: 12px;
        color: #666;
        margin-top: 6px;
    }

    /* Question card */
    .q-card {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 18px;
        padding: 28px;
        margin-bottom: 16px;
    }

    .q-number { font-size: 13px; color: #555; margin-bottom: 8px; }
    .q-text { font-size: 18px; font-weight: 600; line-height: 1.5; margin-bottom: 20px; }

    .q-options { display: flex; flex-direction: column; gap: 10px; }

    .q-option {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 12px;
        border: 1px solid #2a2a2a;
        background: #0d0d0d;
        cursor: pointer;
        transition: all 0.15s;
        font-size: 15px;
        color: #ccc;
    }

    .q-option:hover { border-color: #3a3a3a; background: #161616; color: #fff; }

    .q-option.selected {
        border-color: #2d5a42;
        background: #0f1f17;
        color: #fff;
    }

    .q-option.correct {
        border-color: #4ade80;
        background: #0a1f12;
        color: #4ade80;
    }

    .q-option.wrong {
        border-color: #f87171;
        background: #1f0a0a;
        color: #f87171;
    }

    .q-option-letter {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #1a1a1a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .q-option.selected .q-option-letter { background: #1e3a2f; color: #4ade80; }
    .q-option.correct .q-option-letter { background: #0f3020; color: #4ade80; }
    .q-option.wrong .q-option-letter { background: #3a1010; color: #f87171; }

    /* Nav */
    .quiz-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        gap: 12px;
    }

    .qnav-btn {
        padding: 12px 24px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid #2a2a2a;
        background: #111;
        color: #ccc;
    }

    .qnav-btn:hover { background: #1a1a1a; color: #fff; }
    .qnav-btn:disabled { opacity: 0.3; cursor: default; }

    .qnav-btn.primary {
        background: #166534;
        border-color: #15803d;
        color: #fff;
    }

    .qnav-btn.primary:hover { background: #15803d; }

    .q-counter { font-size: 13px; color: #555; }

    /* Chapter result card */
    .chapter-result-card {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 18px;
        padding: 40px;
        text-align: center;
    }

    .chapter-result-score {
        font-size: 56px;
        font-weight: 700;
        color: #4ade80;
        margin-bottom: 8px;
    }

    .chapter-result-sub { font-size: 16px; color: #888; margin-bottom: 28px; }

    .chapter-result-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    /* Final result */
    .final-result-card {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 18px;
        padding: 48px 40px;
        text-align: center;
    }

    .final-trophy { font-size: 64px; margin-bottom: 16px; }

    .final-score { font-size: 52px; font-weight: 700; color: #4ade80; }

    .final-sub { font-size: 16px; color: #888; margin: 8px 0 28px; }

    .chapter-scores-grid {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 28px;
        text-align: left;
    }

    .chapter-score-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0d0d0d;
        border: 1px solid #1e1e1e;
        border-radius: 10px;
        padding: 12px 16px;
    }

    .chapter-score-name { font-size: 14px; color: #ccc; }
    .chapter-score-val { font-size: 14px; font-weight: 600; color: #4ade80; }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #666;
    }

    @@media (max-width: 768px) {
        .quiz-layout { flex-direction: column; }
        .quiz-sidebar { width: 100%; position: static; }
    }
</style>

<div id="quizRoot">
    <!-- Filled by JS -->
    <div class="empty-state">
        <div style="font-size:40px;">⏳</div>
        <p style="margin-top:12px;">Loading quiz...</p>
    </div>
</div>

@section Scripts {
<script>
const urlParams = new URLSearchParams(window.location.search);
const courseId   = urlParams.get('courseId');
const apiUrl     = courseId ? `/api/api/quiz/questions/${courseId}` : '/api/api/quiz/questions';

let chapters      = [];   // [{order, title, questions:[]}]
let chapterIndex  = 0;    // current chapter (0-based)
let questionIndex = 0;    // question within chapter
let answered      = false;
let chapterScores = [];   // [{name, score, total}]
let totalScore    = 0;
let totalQuestions = 0;

/* ── Boot ── */
$.ajax({
    url: apiUrl,
    type: 'GET',
    success(data) {
        if (!data || data.length === 0) {
            $('#quizRoot').html(`
                <div class="empty-state">
                    <div style="font-size:48px;">❓</div>
                    <p style="margin-top:12px;">No quiz questions available for this course.</p>
                </div>`);
            return;
        }

        // Group into chapters by chapterOrder + chapterTitle
        const map = new Map();
        data.forEach(q => {
            const key = q.chapterOrder ?? 1;
            if (!map.has(key)) {
                map.set(key, {
                    order: key,
                    title: q.chapterTitle || `Chapter ${key}`,
                    questions: []
                });
            }
            map.get(key).questions.push(q);
        });

        chapters = [...map.values()].sort((a, b) => a.order - b.order);
        totalQuestions = data.length;

        renderShell();
        renderQuestion();
    },
    error() {
        $('#quizRoot').html(`<div class="empty-state"><p>Failed to load quiz.</p></div>`);
    }
});

/* ── Shell (sidebar + main area) ── */
function renderShell() {
    const sidebarTabs = chapters.map((ch, i) => `
        <div class="chapter-tab ${i === 0 ? 'active' : ''}" id="tab-${i}" onclick="jumpToChapter(${i})">
            <div class="tab-dot"></div>
            <div class="tab-info">
                <div class="tab-name">${ch.title}</div>
                <div class="tab-count">${ch.questions.length} question${ch.questions.length !== 1 ? 's' : ''}</div>
            </div>
        </div>`).join('');

    $('#quizRoot').html(`
        <div class="quiz-layout">
            <aside class="quiz-sidebar">
                <div class="sidebar-label">Quiz Chapters</div>
                ${sidebarTabs}
                <hr class="sidebar-divider">
                <div class="sidebar-score-box" id="sidebarScore">
                    Score so far: <strong>0 / 0</strong>
                </div>
            </aside>
            <main class="quiz-main" id="quizMain"></main>
        </div>`);
}

/* ── Render current question ── */
function renderQuestion() {
    const ch = chapters[chapterIndex];
    const q  = ch.questions[questionIndex];
    const chTotal  = ch.questions.length;
    const pct = Math.round((questionIndex / chTotal) * 100);
    const letters = ['A','B','C','D'];

    const optionsHtml = q.options.map((opt, i) => `
        <div class="q-option" id="opt-${i}" onclick="selectAnswer(${i})">
            <div class="q-option-letter">${letters[i]}</div>
            ${opt}
        </div>`).join('');

    $('#quizMain').html(`
        <div class="quiz-chapter-header">
            <span class="quiz-chapter-badge">Chapter ${ch.order}</span>
            <h2 class="quiz-chapter-title">${ch.title}</h2>
        </div>

        <div class="quiz-progress-wrap">
            <div class="quiz-progress-bg">
                <div class="quiz-progress-fill" id="qProgressFill" style="width:${pct}%"></div>
            </div>
            <div class="quiz-progress-label" id="qProgressLabel">
                Question ${questionIndex + 1} of ${chTotal}
            </div>
        </div>

        <div class="q-card">
            <div class="q-number">Question ${questionIndex + 1} of ${chTotal}</div>
            <div class="q-text">${q.question}</div>
            <div class="q-options">${optionsHtml}</div>
        </div>

        <div class="quiz-nav">
            <button class="qnav-btn" onclick="prevQuestion()" ${questionIndex === 0 ? 'disabled' : ''}>← Previous</button>
            <span class="q-counter">${questionIndex + 1} / ${chTotal}</span>
            <button class="qnav-btn primary" id="nextBtn" onclick="submitAnswer()">
                ${questionIndex + 1 === chTotal ? 'Finish Chapter' : 'Next →'}
            </button>
        </div>`);

    answered = false;
    updateSidebarScore();
}

/* ── Answer selection ── */
let selectedAnswer = null;

function selectAnswer(idx) {
    if (answered) return;
    selectedAnswer = idx;
    $('.q-option').removeClass('selected');
    $(`#opt-${idx}`).addClass('selected');
}

function submitAnswer() {
    if (selectedAnswer === null) {
        showToast('Please select an answer first', 'error');
        return;
    }

    if (answered) { advanceQuestion(); return; }

    answered = true;
    const ch = chapters[chapterIndex];
    const q  = ch.questions[questionIndex];

    // Store answer on question object
    q._userAnswer = selectedAnswer;
    if (selectedAnswer === q.correctAnswer) {
        totalScore++;
        if (!ch._score) ch._score = 0;
        ch._score++;
    }
    if (!ch._answered) ch._answered = 0;
    ch._answered++;

    // Show correct/wrong highlighting
    for (let i = 0; i < 4; i++) {
        if (i === q.correctAnswer) $(`#opt-${i}`).addClass('correct');
        else if (i === selectedAnswer) $(`#opt-${i}`).addClass('wrong');
    }

    updateSidebarScore();

    // Delay then advance
    setTimeout(advanceQuestion, 900);
}

function advanceQuestion() {
    const ch = chapters[chapterIndex];
    if (questionIndex + 1 < ch.questions.length) {
        questionIndex++;
        selectedAnswer = null;
        renderQuestion();
    } else {
        showChapterResult();
    }
}

function prevQuestion() {
    if (questionIndex > 0) {
        questionIndex--;
        selectedAnswer = null;
        answered = false;
        renderQuestion();
    }
}

/* ── Chapter result ── */
function showChapterResult() {
    const ch = chapters[chapterIndex];
    const score = ch._score || 0;
    const total = ch.questions.length;
    const pct   = Math.round((score / total) * 100);
    const isLast = chapterIndex === chapters.length - 1;

    chapterScores.push({ name: ch.title, score, total });
    markTabDone(chapterIndex);

    const msg = pct >= 80 ? '🎉 Excellent work!' : pct >= 60 ? '👍 Good effort!' : '💪 Keep practising!';

    $('#quizMain').html(`
        <div class="chapter-result-card">
            <div class="chapter-result-score">${score}/${total}</div>
            <div class="chapter-result-sub">You scored ${pct}% on <strong>${ch.title}</strong></div>
            <p style="color:#555;margin-bottom:28px;">${msg}</p>
            <div class="chapter-result-btns">
                <button class="qnav-btn" onclick="retryChapter()">↺ Retry Chapter</button>
                <button class="qnav-btn" onclick="reviewChapter()">👁 Review Answers</button>
                ${isLast
                    ? `<button class="qnav-btn primary" onclick="showFinalResult()">See Final Score 🏆</button>`
                    : `<button class="qnav-btn primary" onclick="nextChapter()">Next Chapter →</button>`
                }
            </div>
        </div>`);
}

/* ── Chapter review ── */
function reviewChapter() {
    const ch = chapters[chapterIndex];
    const letters = ['A','B','C','D'];
    let html = `
        <div class="quiz-chapter-header">
            <span class="quiz-chapter-badge">Review</span>
            <h2 class="quiz-chapter-title">${ch.title}</h2>
        </div>`;

    ch.questions.forEach((q, i) => {
        const ua = q._userAnswer;
        const ca = q.correctAnswer;
        const optHtml = q.options.map((opt, oi) => {
            let cls = '';
            if (oi === ca) cls = 'correct';
            else if (oi === ua && ua !== ca) cls = 'wrong';
            return `<div class="q-option ${cls}" style="cursor:default;">
                        <div class="q-option-letter">${letters[oi]}</div>
                        ${opt}
                    </div>`;
        }).join('');

        html += `
            <div class="q-card">
                <div class="q-number">Question ${i + 1}</div>
                <div class="q-text">${q.question}</div>
                <div class="q-options">${optHtml}</div>
            </div>`;
    });

    html += `<div class="quiz-nav">
                <button class="qnav-btn primary" onclick="showChapterResult()">Back to Results</button>
             </div>`;

    $('#quizMain').html(html);
}

/* ── Retry chapter ── */
function retryChapter() {
    const ch = chapters[chapterIndex];
    ch._score = 0;
    ch._answered = 0;
    ch.questions.forEach(q => delete q._userAnswer);
    questionIndex = 0;
    selectedAnswer = null;
    answered = false;
    renderQuestion();
}

/* ── Next chapter ── */
function nextChapter() {
    chapterIndex++;
    questionIndex = 0;
    selectedAnswer = null;
    answered = false;
    updateSidebarActive();
    renderQuestion();
}

/* ── Jump to chapter from sidebar ── */
function jumpToChapter(idx) {
    chapterIndex = idx;
    questionIndex = 0;
    selectedAnswer = null;
    answered = false;
    updateSidebarActive();
    renderQuestion();
}

/* ── Final result ── */
function showFinalResult() {
    saveQuizScore();

    const pct = Math.round((totalScore / totalQuestions) * 100);
    const trophy = pct >= 80 ? '🏆' : pct >= 60 ? '🥈' : '📚';
    const msg = pct >= 80 ? 'Outstanding!' : pct >= 60 ? 'Good job!' : 'Keep learning!';

    const breakdownHtml = chapterScores.map(cs => `
        <div class="chapter-score-row">
            <div class="chapter-score-name">${cs.name}</div>
            <div class="chapter-score-val">${cs.score}/${cs.total} (${Math.round(cs.score/cs.total*100)}%)</div>
        </div>`).join('');

    $('#quizMain').html(`
        <div class="final-result-card">
            <div class="final-trophy">${trophy}</div>
            <div class="final-score">${totalScore}/${totalQuestions}</div>
            <div class="final-sub">You scored ${pct}% — ${msg}</div>

            <div class="chapter-scores-grid">${breakdownHtml}</div>

            <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                <button class="qnav-btn" onclick="restartAll()">↺ Retake Quiz</button>
                ${courseId ? `<a href="/Learning?courseId=${courseId}" class="qnav-btn primary">← Back to Course</a>` : ''}
            </div>
        </div>`);
}

/* ── Restart everything ── */
function restartAll() {
    chapterIndex = 0;
    questionIndex = 0;
    selectedAnswer = null;
    answered = false;
    totalScore = 0;
    chapterScores = [];
    chapters.forEach(ch => {
        ch._score = 0;
        ch._answered = 0;
        ch.questions.forEach(q => delete q._userAnswer);
    });
    $('.chapter-tab').removeClass('done');
    updateSidebarActive();
    renderQuestion();
}

/* ── Sidebar helpers ── */
function updateSidebarActive() {
    $('.chapter-tab').removeClass('active');
    $(`#tab-${chapterIndex}`).addClass('active');
}

function markTabDone(idx) {
    $(`#tab-${idx}`).addClass('done').removeClass('active');
}

function updateSidebarScore() {
    $('#sidebarScore').html(`Score so far: <strong>${totalScore} / ${totalQuestions}</strong>`);
}

/* ── Save score ── */
function saveQuizScore() {
    if (!courseId) return;
    $.ajax({
        url: '/api/api/quiz/save',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            courseId: parseInt(courseId),
            score: totalScore,
            total: totalQuestions,
            percentage: Math.round((totalScore / totalQuestions) * 100)
        })
    });
}
</script>
}
