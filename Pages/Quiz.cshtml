@page
@model APLH.Pages.QuizModel
@{
    ViewData["Title"] = "Quiz";
}

<div class="page-header">
    <h1>Quiz Challenge</h1>
    <p>Test your knowledge and improve your skills.</p>
</div>

<div class="quiz-container">

    <div class="progress-bar-outer">
        <div class="progress-bar-inner"
             id="quizProgress"
             style="width:0%">
        </div>
    </div>

    <div id="quizArea"></div>

    <div id="quizResult"
         class="quiz-result"
         style="display:none;">

        <div class="quiz-score"
             id="finalScore">
        </div>

        <div class="result-msg"
             id="resultMessage">
        </div>

        <button class="btn btn-primary btn-lg"
                onclick="restartQuiz()">

            Try Again

        </button>
    </div>

</div>

@section Scripts {

<script>

    let questions = [];

    let currentQuestion = 0;

    let score = 0;

    let selectedAnswer = null;

    let userAnswers = [];

    function loadQuizQuestions() {

        // Get course ID from URL parameter if provided
        const urlParams = new URLSearchParams(window.location.search);
        const courseId = urlParams.get('courseId');
        
        const url = courseId 
            ? `/api/api/quiz/questions/${courseId}`
            : '/api/api/quiz/questions';

        $.ajax({

            url: url,

            type: 'GET',

            success: function(data) {

                questions = data;

                if (questions.length === 0) {

                    $('#quizArea').html(`
                        <div class="empty-state">
                            <div class="icon">❓</div>
                            <p>No quiz questions available for this course.</p>
                        </div>
                    `);

                    return;
                }

                loadQuestion();
            }
        });
    }

    function loadQuestion() {

        selectedAnswer = null;

        const q = questions[currentQuestion];

        $('#quizProgress').css(
            'width',
            `${(currentQuestion / questions.length) * 100}%`
        );

        $('#quizArea').html(`

            <div class="quiz-card">

                <div class="quiz-q">

                    Question ${currentQuestion + 1}
                    of ${questions.length}

                    <br><br>

                    ${q.question}

                </div>

                <div class="quiz-options">

                    ${q.options.map((option, index) => `

                        <div class="quiz-option"
                             onclick="selectAnswer(${index})">

                            ${option}

                        </div>

                    `).join('')}

                </div>

                <div style="margin-top:25px;text-align:right;">

                    <button class="btn btn-primary"
                            onclick="submitAnswer()">

                        ${currentQuestion + 1 === questions.length
                            ? 'Finish Quiz'
                            : 'Next Question'}

                    </button>

                </div>

            </div>

        `);
    }

    function selectAnswer(index) {

        selectedAnswer = index;

        $('.quiz-option').removeClass('selected');

        $('.quiz-option')
            .eq(index)
            .addClass('selected');
    }

    function submitAnswer() {

        if (selectedAnswer === null) {
            showToast('Please select an answer first', 'error');
            return;
        }

        userAnswers[currentQuestion] = selectedAnswer;

        if (selectedAnswer === questions[currentQuestion].correctAnswer) {
            score++;
        }

        currentQuestion++;

        if (currentQuestion < questions.length) {
            loadQuestion();
        } else {
            showResult();
        }
    }

    function showResult() {
    $('#quizArea').hide();
    $('#quizResult').show();
    $('#quizProgress').css('width', '100%');

    const percentage = Math.round((score / questions.length) * 100);

    $('#finalScore').text(`${score}/${questions.length}`);
    $('#resultMessage').text(`You scored ${percentage}%`);

    let reviewHtml = `<div class="quiz-review"><h2>Quiz Review</h2>`;

    questions.forEach((q, index) => {
        const userAnswer = userAnswers[index];
        const correctAnswer = q.correctAnswer;

        reviewHtml += `
            <div class="review-card">
                <h4>Question ${index + 1}: ${q.question}</h4>

                <p><strong>Your Answer:</strong> ${q.options[userAnswer]}</p>
                <p><strong>Correct Answer:</strong> ${q.options[correctAnswer]}</p>

                ${
                    userAnswer === correctAnswer
                    ? `<p class="correct">✅ Correct</p>`
                    : `<p class="wrong">❌ Wrong</p>`
                }
            </div>
        `;
    });

    reviewHtml += `</div>`;

    $('#quizResult').append(reviewHtml);

    saveQuizScore(score, questions.length, percentage);
}

    function saveQuizScore(score, totalQuestions, percentage) {

        const urlParams = new URLSearchParams(window.location.search);
        const courseId = urlParams.get('courseId');

        $.ajax({
            url: '/api/api/quiz/save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                courseId: parseInt(courseId),
                score: score,
                total: totalQuestions,
                percentage: percentage
            })
        });
    }

    function restartQuiz() {

        currentQuestion = 0;

        score = 0;

        $('#quizResult').hide();

        $('#quizArea').show();

        userAnswers = [];
            $('.quiz-review').remove();

        loadQuestion();
    }

    $(document).ready(function () {

        loadQuizQuestions();

    });

</script>

}