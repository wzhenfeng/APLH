@page
@model APLH.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="profile-container">

    <div class="profile-header">
        <h1>My Profile</h1>
        <p>Welcome back, @Model.UserName 👋</p>
    </div>

    <div class="profile-grid">

        <div class="profile-card">
            <h3>Account Information</h3>

            <div class="profile-info">
                <p><strong>Name:</strong> @Model.UserName</p>
                <p><strong>Email:</strong> @Model.UserEmail</p>
                <p><strong>Role:</strong> @Model.UserRole</p>
            </div>
        </div>

        @if (!User.IsInRole("admin"))
        {
            <div class="profile-card">
                <h3>Statistics</h3>

                <div class="profile-info">
                    <p><strong>Enrolled Courses:</strong> @Model.Course.Count</p>
                    <p><strong>Total Quiz Attempts:</strong> @Model.QuizScore.Count</p>
                </div>
            </div>
        }

    </div>

    @if (!User.IsInRole("admin"))
    {
        <div class="profile-card" style="margin-top:30px;">
            <h3>Enrolled Courses</h3>

            @if (Model.Course.Count > 0)
            {
                @foreach (var course in Model.Course)
                {
                    var quizScore = Model.QuizScore
                        .FirstOrDefault(q => q.CourseId == course.Id);

                    <div class="course-item">
                        <h4>@course.Title</h4>
                        <p>@course.Description</p>

                        @if (quizScore != null)
                        {
                            <p><strong>Quiz Score:</strong> @quizScore.Score / @quizScore.TotalQuestions</p>
                            <p><strong>Percentage:</strong> @quizScore.Percentage%</p>
                        }
                        else
                        {
                            <p><strong>Quiz Score:</strong> Not attempted yet</p>
                        }
                    </div>
                }
            }
            else
            {
                <p>No enrolled courses.</p>
            }
        </div>
    }

</div>