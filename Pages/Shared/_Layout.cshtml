@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userName = isAuthenticated ? User.FindFirst(ClaimTypes.Name)?.Value : "";
    var userRole = isAuthenticated ? User.FindFirst(ClaimTypes.Role)?.Value : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - APLH</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <div class="nav-logo" onclick="location.href='/'">APLH</div>
        <div class="nav-links">
            @if (!User.IsInRole("admin"))
            {
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" href="/">Home</a>
            }

            
            
            @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Courses" ? "active" : "")" href="/Courses">Courses</a>

                    @if (User.IsInRole("admin"))
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin" ? "active" : "")" href="/Admin">Admin</a>
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/ActivityLogs" ? "active" : "")" href="/ActivityLogs">Activity Logs</a>
                    }
                }
            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/About" ? "active" : "")" href="/About">About</a>
            
        </div>
        <div class="nav-right">
            @if (isAuthenticated)
            {
                <span class="user-name">@userName</span>
                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Profile" ? "active" : "")" href="/Profile">My Profile</a>
                <button class="btn btn-ghost btn-sm" onclick="logout()">Log Out</button>
            }
            else
            {
                <button class="btn btn-ghost btn-sm" onclick="openLoginModal()">Log In</button>
                <button class="btn btn-primary btn-sm" onclick="openRegisterModal()">Get Started</button>
            }
        </div>
    </nav>

    <div class="toast" id="toast"></div>
    
    <main role="main">
        @RenderBody()
    </main>

    <footer>
    <p>&copy; 2026 APLH · Building the future of education</p>
    </footer>

    <!-- Modals -->
    <div class="modal-overlay" id="loginModal">
        <div class="modal login-modal">
            <div class="login-left">
                <svg class="poly-bg" viewBox="0 0 400 560" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="400" height="560" fill="#123a63"/>
                    <polygon points="0,0 220,0 130,120 0,80" fill="#1a5a94" opacity="0.9"/>
                    <polygon points="220,0 400,0 400,110 260,180 130,120" fill="#0d2a4a" opacity="0.85"/>
                    <polygon points="0,80 130,120 90,230 0,210" fill="#2f7fc4" opacity="0.3"/>
                    <polygon points="130,120 260,180 220,300 90,230" fill="#164a7c" opacity="0.9"/>
                    <polygon points="260,180 400,110 400,260 220,300" fill="#1a5a94" opacity="0.6"/>
                    <polygon points="0,210 90,230 60,340 0,330" fill="#0d2a4a" opacity="0.9"/>
                    <polygon points="90,230 220,300 180,420 60,340" fill="#2f7fc4" opacity="0.25"/>
                    <polygon points="220,300 400,260 400,430 180,420" fill="#0d2a4a" opacity="0.8"/>
                    <polygon points="0,330 60,340 40,470 0,460" fill="#164a7c" opacity="0.9"/>
                    <polygon points="60,340 180,420 140,560 40,470" fill="#1a5a94" opacity="0.5"/>
                    <polygon points="180,420 400,430 400,560 140,560" fill="#0a2038" opacity="0.85"/>
                    <polygon points="0,460 40,470 0,560" fill="#0d2a4a" opacity="0.9"/>
                    <polygon points="0,560 40,470 140,560" fill="#12406e" opacity="0.6"/>
                </svg>
                <div class="login-left-content">
                    <div class="brand-mark">
                        <div class="brand-text">APLH</div>
                    </div>
                    <h3>Learn Skills<br>That Actually Matter</h3>
                    <p>Sign in to pick up where you left off — your courses, quizzes, and progress are waiting.</p>
                </div>
            </div>

            <div class="login-right">
                <div class="login-people-icon">
                    <svg width="52" height="34" viewBox="0 0 52 34" fill="none">
                        <circle cx="26" cy="8" r="6" stroke="#2f7fc4" stroke-width="1.8"/>
                        <path d="M14 30v-3c0-5 5-8.5 12-8.5s12 3.5 12 8.5v3" stroke="#2f7fc4" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="9" cy="12" r="4.5" stroke="#7fb2de" stroke-width="1.6"/>
                        <path d="M2 30v-2.3c0-3.6 3.4-6.2 7-6.2 1.6 0 3.1.5 4.3 1.3" stroke="#7fb2de" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="43" cy="12" r="4.5" stroke="#7fb2de" stroke-width="1.6"/>
                        <path d="M50 30v-2.3c0-3.6-3.4-6.2-7-6.2-1.6 0-3.1.5-4.3 1.3" stroke="#7fb2de" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </div>
                <h2 style="text-align:center;">Welcome <span>Back</span></h2>
                <div class="alert" id="loginAlert"></div>

                <div class="form-group input-group">
                    <span class="field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <input type="email" id="loginEmail" placeholder="you@example.com">
                    <div class="form-error" id="loginEmailErr">Please enter a valid email.</div>
                </div>

                <div class="form-group input-group">
                    <span class="field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8"/></svg>
                    </span>
                    <input type="password" id="loginPassword" placeholder="••••••••">
                    <div class="form-error" id="loginPassErr">Password is required.</div>
                </div>

                <div class="login-row">
                    <label class="remember-me"><input type="checkbox" id="loginRemember"> Remember me</label>
                    <a href="#" class="forgot-link" onclick="openForgotPasswordModal(); return false;">Forgot Password?</a>
                </div>

                <button class="btn-login" onclick="handleLogin()">Log In</button>

                <div class="divider-text">or</div>
                <button class="btn-login btn-login-alt"
                        onclick="location.href='/api/api/auth/google-login'">
                    Continue with Google
                </button>

                <button class="btn btn-ghost" style="width:100%; margin-top:10px;" onclick="closeModal('loginModal')">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Forgot Password Step 1: Enter Email -->
    <div class="modal-overlay" id="forgotPasswordModal">
        <div class="modal">
            <h2>Reset <span>Password</span></h2>
            <p style="color:var(--text-muted); margin-bottom:16px; font-size:0.9rem;">Enter the email address linked to your account and we'll send you a 6-digit OTP.</p>
            <div class="alert" id="forgotAlert"></div>
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" id="forgotEmail" placeholder="you@example.com">
                <div class="form-error" id="forgotEmailErr">Please enter a valid email.</div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="handleForgotPassword()">Send OTP</button>
                <button class="btn btn-ghost" onclick="closeModal('forgotPasswordModal'); openLoginModal()">Back to Login</button>
            </div>
        </div>
    </div>

    <!-- Forgot Password Step 2: Verify OTP -->
    <div class="modal-overlay" id="otpModal">
        <div class="modal">
            <h2>Verify <span>OTP</span></h2>
            <p style="color:var(--text-muted); margin-bottom:16px; font-size:0.9rem;">Enter the 6-digit code sent to your email. It expires in 10 minutes.</p>
            <div class="alert" id="otpAlert"></div>
            <div class="form-group">
                <label>One-Time Password</label>
                <input type="text" id="otpCode" placeholder="123456" maxlength="6" style="letter-spacing:6px; font-size:1.4rem; text-align:center;">
                <div class="form-error" id="otpCodeErr">Please enter the 6-digit OTP.</div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="handleVerifyOtp()">Verify OTP</button>
                <button class="btn btn-ghost" onclick="closeModal('otpModal'); openForgotPasswordModal()">Resend OTP</button>
            </div>
        </div>
    </div>

    <!-- Forgot Password Step 3: Set New Password -->
    <div class="modal-overlay" id="resetPasswordModal">
        <div class="modal">
            <h2>New <span>Password</span></h2>
            <p style="color:var(--text-muted); margin-bottom:16px; font-size:0.9rem;">Choose a strong new password for your account.</p>
            <div class="alert" id="resetAlert"></div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" id="resetNewPassword" placeholder="Min 6 characters">
                <div class="form-error" id="resetPassErr">Password must be at least 6 characters.</div>
            </div>
            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" id="resetConfirmPassword" placeholder="Repeat new password">
                <div class="form-error" id="resetConfErr">Passwords do not match.</div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="handleResetPassword()">Reset Password</button>
                <button class="btn btn-ghost" onclick="closeModal('resetPasswordModal')">Cancel</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="registerModal">
        <div class="modal login-modal">
            <div class="login-left">
                <svg class="poly-bg" viewBox="0 0 400 560" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="400" height="560" fill="#123a63"/>
                    <polygon points="0,0 220,0 130,120 0,80" fill="#1a5a94" opacity="0.9"/>
                    <polygon points="220,0 400,0 400,110 260,180 130,120" fill="#0d2a4a" opacity="0.85"/>
                    <polygon points="0,80 130,120 90,230 0,210" fill="#2f7fc4" opacity="0.3"/>
                    <polygon points="130,120 260,180 220,300 90,230" fill="#164a7c" opacity="0.9"/>
                    <polygon points="260,180 400,110 400,260 220,300" fill="#1a5a94" opacity="0.6"/>
                    <polygon points="0,210 90,230 60,340 0,330" fill="#0d2a4a" opacity="0.9"/>
                    <polygon points="90,230 220,300 180,420 60,340" fill="#2f7fc4" opacity="0.25"/>
                    <polygon points="220,300 400,260 400,430 180,420" fill="#0d2a4a" opacity="0.8"/>
                    <polygon points="0,330 60,340 40,470 0,460" fill="#164a7c" opacity="0.9"/>
                    <polygon points="60,340 180,420 140,560 40,470" fill="#1a5a94" opacity="0.5"/>
                    <polygon points="180,420 400,430 400,560 140,560" fill="#0a2038" opacity="0.85"/>
                    <polygon points="0,460 40,470 0,560" fill="#0d2a4a" opacity="0.9"/>
                    <polygon points="0,560 40,470 140,560" fill="#12406e" opacity="0.6"/>
                </svg>
                <div class="login-left-content">
                    <div class="brand-mark">
                        <div class="brand-text">APLH</div>
                    </div>
                    <h3>Start Learning<br>Skills That Matter</h3>
                    <p>Create your free account to unlock courses, quizzes, and progress tracking.</p>
                </div>
            </div>

            <div class="login-right">
                <div class="login-people-icon">
                    <svg width="52" height="34" viewBox="0 0 52 34" fill="none">
                        <circle cx="26" cy="8" r="6" stroke="#2f7fc4" stroke-width="1.8"/>
                        <path d="M14 30v-3c0-5 5-8.5 12-8.5s12 3.5 12 8.5v3" stroke="#2f7fc4" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="9" cy="12" r="4.5" stroke="#7fb2de" stroke-width="1.6"/>
                        <path d="M2 30v-2.3c0-3.6 3.4-6.2 7-6.2 1.6 0 3.1.5 4.3 1.3" stroke="#7fb2de" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="43" cy="12" r="4.5" stroke="#7fb2de" stroke-width="1.6"/>
                        <path d="M50 30v-2.3c0-3.6-3.4-6.2-7-6.2-1.6 0-3.1.5-4.3 1.3" stroke="#7fb2de" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </div>
                <h2 style="text-align:center;">Create <span>Account</span></h2>
                <div class="alert" id="regAlert"></div>

                <div class="form-group input-group">
                    <span class="field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <input type="text" id="regName" placeholder="Your full name">
                    <div class="form-error" id="regNameErr">Name is required (min 2 chars).</div>
                </div>

                <div class="form-group input-group">
                    <span class="field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 6.5 11 13a2 2 0 0 0 2 0l8-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <input type="email" id="regEmail" placeholder="you@example.com">
                    <div class="form-error" id="regEmailErr">Enter a valid email address.</div>
                </div>

                <div class="form-group input-group">
                    <span class="field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8"/></svg>
                    </span>
                    <input type="password" id="regPassword" placeholder="Min 6 characters">
                    <div class="form-error" id="regPassErr">Password must be at least 6 characters.</div>
                </div>

                <div class="form-group input-group">
                    <span class="field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8"/><path d="M12 15v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </span>
                    <input type="password" id="regConfirm" placeholder="Repeat password">
                    <div class="form-error" id="regConfErr">Passwords do not match.</div>
                </div>

                <button class="btn-login" style="margin-top:0.3rem;" onclick="handleRegister()">Create Account</button>

                <div class="divider-text">or</div>
                <button class="btn-login btn-login-alt"
                        onclick="location.href='/api/api/auth/google-login'">
                    Continue with Google
                </button>

                <button class="btn btn-ghost" style="width:100%; margin-top:10px;" onclick="closeModal('registerModal')">Cancel</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="courseModal">
        <div class="modal" style="max-width:560px">
            <h2 id="courseModalTitle">Add <span>Course</span></h2>
            <input type="hidden" id="courseEditId">
            <div class="form-group">
                <label>Course Title</label>
                <input type="text" id="courseTitle" placeholder="e.g. Introduction to Python">
                <div class="form-error" id="courseTitleErr">Title is required.</div>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea id="courseDesc" placeholder="What will students learn?"></textarea>
                <div class="form-error" id="courseDescErr">Description is required.</div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px">
                <div class="form-group">
                    <label>
                        Category
                        <a href="#" id="addCategoryLink" onclick="openCategoryModal(event)" style="float:right; font-weight:normal; font-size:0.8em; color:var(--accent3); text-decoration:none;">+ Add category</a>
                    </label>
                    <select id="courseCat">
                        <option value="Technology">Technology</option>
                        <option value="Design">Design</option>
                        <option value="Business">Business</option>
                        <option value="Science">Science</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Level</label>
                    <select id="courseLevel">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px">
                <div class="form-group">
                    <label>Price (0 = Free)</label>
                    <input type="number" id="coursePrice" min="0" value="0">
                </div>
                <div class="form-group">
                    <label>Duration (hours)</label>
                    <input type="number" id="courseDuration" min="1" value="8">
                </div>
            </div>
            <div class="form-group">
                <label>Display Title</label>
                <input type="text" id="courseEmoji" placeholder="e.g. 🐍" value="📚">
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="saveCourse()">Save Course</button>
                <button class="btn btn-ghost" onclick="closeModal('courseModal')">Cancel</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="categoryModal">
        <div class="modal" style="max-width:400px">
            <h2>Add <span>Category</span></h2>
            <div class="form-group">
                <label>Category Name</label>
                <input type="text" id="newCategoryName" placeholder="e.g. Marketing">
                <div class="form-error" id="newCategoryErr">Category name is required.</div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" style="flex:1" onclick="confirmAddCategory()">Add Category</button>
                <button class="btn btn-ghost" onclick="closeModal('categoryModal')">Cancel</button>
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("member"))
            {
                <a href="/Chat" class="floating-chat-btn">
                💬
                <span>Ask me!</span>
                </a>
            }

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("admin"))
            {
                <a href="/AdminChat" class="floating-chat-btn">
                    💬
                    <span>Ask me!</span>
                </a>
            }

    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp - append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>