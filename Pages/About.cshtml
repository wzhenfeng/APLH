@page
@{
    ViewData["Title"] = "About - APLH";
}

<div class="about-hero">
    <h1>About <span style="color:var(--accent)">APLH</span></h1>
    <p>APLH was founded on a simple belief: quality education should be accessible to everyone, everywhere. We connect passionate learners with expert instructors in a beautifully designed digital classroom.</p>
    <div style="display:flex; gap:2rem; justify-content:center; flex-wrap:wrap; margin-top:2rem">
        <div style="text-align:center">
            <div style="font-family:var(--font-display); font-size:2rem; font-weight:900; color:var(--accent)">2026</div>
            <div style="color:var(--text2); font-size:0.875rem">Founded</div>
        </div>
        <div style="text-align:center">
            <div style="font-family:var(--font-display); font-size:2rem; font-weight:900; color:var(--accent3)">Malaysia</div>
            <div style="color:var(--text2); font-size:0.875rem">Country</div>
        </div>
        <div style="text-align:center">
            <div style="font-family:var(--font-display); font-size:2rem; font-weight:900; color:var(--green)">98%</div>
            <div style="color:var(--text2); font-size:0.875rem">Satisfaction Rate</div>
        </div>
    </div>
</div>

<div class="team-section">
    <div class="section-title mb-2">Meet the Team</div>
    <div class="team-grid">
        <div class="team-card">
            <div class="team-avatar" style="background:linear-gradient(135deg,#ff6b6b,#ff8e53)">👨</div>
            <h3>WONG ZHEN FENG</h3>
            <p class="text-muted" style="margin-top:4px">CEO & Lead Educator</p>
        </div>
        <div class="team-card">
            <div class="team-avatar" style="background:linear-gradient(135deg,#6bcbff,#a78bfa)">👩</div>
            <h3>GUBAEVA LILIIA</h3>
            <p class="text-muted" style="margin-top:4px">Head of Technology</p>
        </div>
        <div class="team-card">
            <div class="team-avatar" style="background:linear-gradient(135deg,#4ade80,#6bcbff)">👨</div>
            <h3>NG JUN HAN</h3>
            <p class="text-muted" style="margin-top:4px">Director of Design</p>
        </div>
        <div class="team-card">
            <div class="team-avatar" style="background:linear-gradient(135deg,#fbbf24,#f87171)">👨</div>
            <h3>TONNY QUEK</h3>
            <p class="text-muted" style="margin-top:4px">Business Director</p>
        </div>
    </div>
</div>

