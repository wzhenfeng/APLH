@page
@model APLH.Pages.HashPasswordModel

<h2>Password Hasher</h2>

<form method="post">
    <input type="text" name="password" placeholder="Enter password" />
    <button type="submit">Hash</button>
</form>

@if (!string.IsNullOrEmpty(Model.HashedPassword))
{
    <div>
        <h3>Hashed Password:</h3>
        <textarea style="width:100%; height:100px;">@Model.HashedPassword</textarea>
    </div>
}

<hr />
<h3>Quick Hashes:</h3>
<p><strong>admin123:</strong> @BCrypt.Net.BCrypt.HashPassword("admin123")</p>
<p><strong>pass123:</strong> @BCrypt.Net.BCrypt.HashPassword("pass123")</p>
